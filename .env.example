# 複製成 .env 再填。全部都是選填。
# 頁面與 Excel 上顯示的店名
PSHEET_BRAND=示範不動產
# 監聽位址：127.0.0.1＝只有這台電腦能用（預設、最安全）。
# 要讓同一個區網的同事連進來，改成 0.0.0.0（或本機區網 IP），而且「一定要」設下面的 PSHEET_PASSWORD，
# 沒設密碼或密碼少於 8 個字，程式會拒絕啟動（原因寫在畫面或 data\psheet.log）。
PSHEET_HOST=127.0.0.1
PSHEET_PORT=8000
# 存取密碼（至少 8 個字）。有填就會在打開網頁時跳出帳號密碼視窗：帳號隨意填，密碼填這裡的值。
# 只在本機用可以不填；用 cloudflared／ngrok 等通道轉發到本機時也請務必填。
PSHEET_PASSWORD=
# 自訂範本路徑（版面需和 sheet/layout.py 一致）；空白＝用程式內建的通用範本
PSHEET_TEMPLATE=
# 選用：填了才會用 Claude 產生案名與銷售重點，不填就用簡單規則
ANTHROPIC_API_KEY=
PSHEET_AI_MODEL=claude-sonnet-5-5
# 周邊設施查詢用的 Overpass 站台（逗號分隔，依序嘗試）
# PSHEET_OVERPASS_URLS=https://overpass-api.de/api/interpreter
# PSHEET_NEARBY_BUDGET=12   # 周邊設施查詢總共最多等幾秒，超過就留空

# 選用：內政部「地政整合資訊服務共享協作平台」官方土地標示部核對（每筆收費，約 NT$1）
# 申請步驟見 docs/金鑰申請.md。不填就不會呼叫。
MOI_COP_CLIENT_ID=
MOI_COP_SECRET=
# 每天最多查幾筆（防止誤按或程式出錯一直扣錢）
MOI_DAILY_LIMIT=20
# 平台回傳的「土地面積」欄位名稱。留白＝自動找（欄位名含 AREA 的第一個數字）。
# 平台改版或自動找錯欄位時，填正確的欄位名稱；找不到欄位會顯示「核對失敗：找不到面積欄位」，不會默默當成 0。
PSHEET_MOI_AREA_FIELD=
